#!/bin/bash
# uaeh-validar — corre los validadores de security-audit SIN modificarlos, con Node de Linux en Docker
# (los validadores exigen O_NOFOLLOW, que Node en Windows no tiene). Los validadores viven en
# /opt/uaeh/validadores (copia de root que deja instalar-bin.sh desde vendor/security-audit del plugin) y la
# carpeta de corridas sale de /opt/uaeh/uaeh.conf.
# Uso:  uaeh-validar <dir-run>      valida findings.json y coverage-ledger.json del run
#       uaeh-validar --pruebas      corre las suites *.test.cjs de los validadores
# Salida: "VALIDAR findings: OK|FALLA" y "VALIDAR ledger: OK|FALLA"; código 0 solo si ambos OK.
set -uo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022

SKILL=/opt/uaeh/validadores
IMAGENES=/opt/uaeh/imagenes.json
DOCKER=/usr/bin/docker
PY=/usr/bin/python3

err(){ echo "uaeh-validar: ERROR: $*" >&2; exit 64; }

# >>> bloque común «validar» (idéntico en instalar.sh, instalar-bin.sh, bin/uaeh-sandbox y bin/uaeh-validar;
#     tests/harness/wsl.test.cjs exige que sea el mismo byte a byte; uaeh-promover repite las reglas en Python)
usuario_valido(){  # $1 → 0 si es un usuario aceptable; si no, 1 con el motivo en MOTIVO
  MOTIVO=""
  if [[ ! "${1-}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then MOTIVO="usuario «${1-}» no válido (minúsculas, cifras, _ o -)"; return 1; fi
  if [ "$1" = root ]; then MOTIVO="el usuario no puede ser root"; return 1; fi
  return 0
}
base_valida(){  # $1 carpeta de corridas, $2 usuario → 0 si cumple; si no, 1 con el motivo en MOTIVO
  local b="${1-}" u="${2-}" c n=0 primera="" segunda=""
  MOTIVO=""
  if [[ ! "$b" =~ ^/[A-Za-z0-9._/-]+$ ]]; then MOTIVO="«$b» debe ser una ruta absoluta de Linux con solo letras sin acento, cifras, . _ - y /"; return 1; fi
  if [[ "$b" == *//* || "$b" == */ ]]; then MOTIVO="«$b» no puede llevar «//» ni terminar en «/»"; return 1; fi
  local IFS=/
  for c in ${b#/}; do
    n=$((n + 1))
    if [ "$c" = . ] || [ "$c" = .. ]; then MOTIVO="«$b» no puede llevar componentes «.» ni «..»"; return 1; fi
    if [ "$n" = 1 ]; then primera=$c; fi
    if [ "$n" = 2 ]; then segunda=$c; fi
  done
  if [ "$n" -lt 3 ]; then MOTIVO="«$b» es demasiado amplia: hacen falta 3 niveles o más (p. ej. /home/<usuario>/runs o /mnt/c/<carpeta>/runs)"; return 1; fi
  case "$primera" in
    mnt|srv) ;;
    home) if [ "$segunda" != "$u" ]; then MOTIVO="bajo /home solo vale la carpeta del propio usuario (/home/$u/…)"; return 1; fi ;;
    *) MOTIVO="«$b» debe colgar de /mnt, /home/<usuario> o /srv"; return 1 ;;
  esac
  return 0
}
resolver_usuario(){  # UAEH_USER > SUDO_USER (si no es root) > el usuario con uid 1000
  if [ -n "${UAEH_USER-}" ]; then printf '%s' "$UAEH_USER"
  elif [ -n "${SUDO_USER-}" ] && [ "$SUDO_USER" != root ]; then printf '%s' "$SUDO_USER"
  else { getent passwd 1000 2>/dev/null || true; } | cut -d: -f1; fi
}
# <<< bloque común «validar»

# >>> bloque común «conf» (idéntico en bin/uaeh-sandbox y bin/uaeh-validar; lo exige tests/harness/wsl.test.cjs)
CONF=/opt/uaeh/uaeh.conf
conf_segura(){  # $1 → existe, no es enlace, es de root y ni el grupo ni otros pueden escribirlo
  local s
  { [ -f "$1" ] && [ ! -L "$1" ]; } || err "falta $1 (lo escribe wsl/instalar-bin.sh del plugin, como root)"
  s=$(stat -c '%u %a' -- "$1" 2>/dev/null) || err "no se pudo leer $1"
  [[ "$s" =~ ^0\ ([0-7]{3,4})$ ]] || err "$1 debe ser de root"
  (( (8#${BASH_REMATCH[1]} & 8#022) == 0 )) || err "$1 no debe ser escribible por el grupo ni por otros"
}
leer_conf(){  # $1 → BASE y USUARIO (solo claves conocidas; cada valor se revalida con el bloque «validar»)
  local linea
  BASE=""; USUARIO=""
  [ -f "$1" ] || err "falta $1"
  while IFS= read -r linea || [ -n "$linea" ]; do
    case "$linea" in ''|'#'*) continue ;; esac
    if [[ "$linea" =~ ^UAEH_BASE=(.*)$ ]]; then BASE=${BASH_REMATCH[1]}
    elif [[ "$linea" =~ ^UAEH_USER=(.*)$ ]]; then USUARIO=${BASH_REMATCH[1]}
    else err "línea desconocida en $1"; fi
  done < "$1"
  usuario_valido "$USUARIO" || err "UAEH_USER en $1: $MOTIVO"
  base_valida "$BASE" "$USUARIO" || err "UAEH_BASE en $1: $MOTIVO"
}
ids_usuario(){  # USUARIO (de uaeh.conf) → UID_U y GID_U, nunca 0: los contenedores corren con la identidad de quien crea
                # las carpetas del run (en WSL suele ser 1000; en otro Linux, no: un uid fijo deja /scratch sin escritura)
  UID_U=$(id -u -- "$USUARIO" 2>/dev/null) || err "el usuario $USUARIO de $CONF no existe en este Linux"
  GID_U=$(id -g -- "$USUARIO" 2>/dev/null) || err "el usuario $USUARIO de $CONF no existe en este Linux"
  { [[ "$UID_U" =~ ^[1-9][0-9]{0,9}$ ]] && [[ "$GID_U" =~ ^[1-9][0-9]{0,9}$ ]]; } \
    || err "uid/gid de $USUARIO no válidos ($UID_U:$GID_U): los contenedores nunca corren como root"
}
normaliza_run(){  # $1 → <BASE>/<repo>/run-N como ruta real exacta (sin enlaces); BASE se compara LITERAL, nunca como regex
  local p="$1" r resto nombre
  if [[ "$p" =~ ^[A-Za-z]:[\\/] ]]; then
    [ -x /usr/bin/wslpath ] || err "ruta de Windows fuera de WSL (usar la ruta de Linux): $p"
    p=$(/usr/bin/wslpath -u "$p" 2>/dev/null) || err "wslpath no convirtió la ruta: $1"
  fi
  p="${p%/}"
  [[ "$p" == "$BASE"/* ]] || err "run fuera de $BASE/<repo>/run-N: $p"
  resto=${p#"$BASE"/}
  [[ "$resto" =~ ^[A-Za-z0-9._-]{1,80}/run-[0-9]{1,6}$ ]] || err "run fuera de $BASE/<repo>/run-N: $p"
  nombre=${resto%%/*}
  { [ "$nombre" != . ] && [ "$nombre" != .. ]; } || err "ruta con . o ..: $p"
  r=$(realpath -e -- "$p" 2>/dev/null) || err "no existe: $p"
  [ "$r" = "$p" ] || err "la ruta pasa por un enlace: $p -> $r"
  printf '%s' "$p"
}
# <<< bloque común «conf»

imagen_node(){
  [ -f "$IMAGENES" ] || err "falta $IMAGENES (lo escribe wsl/instalar.sh)"
  local v
  v=$("$PY" -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("node",""))' "$IMAGENES") || err "no se pudo leer $IMAGENES"
  [[ "$v" =~ ^[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]] || err "imagen 'node' no válida en $IMAGENES"
  printf '%s' "$v"
}

principal(){
  [ $# -eq 1 ] || err "uso: uaeh-validar <dir-run> | --pruebas"
  { [ -d "$SKILL" ] && [ ! -L "$SKILL" ] && [ -f "$SKILL/validate-findings.cjs" ]; } \
    || err "faltan los validadores en $SKILL (instalar-bin.sh los copia desde vendor/security-audit del plugin)"
  IMG=$(imagen_node) || exit 64
  COMUNES=(--rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges
           --pids-limit 128 --memory 512m
           --mount "type=bind,src=$SKILL,dst=/skill,readonly")

  if [ "$1" = "--pruebas" ]; then
    # Las suites escriben temporales (os.tmpdir) -> tmpfs privado y descartable.
    # --test-reporter=spec y cwd /skill (solo lectura): node:test no escribe en el cwd.
    # Solo leen /skill (de root, legible por todos): basta un uid sin privilegios, sin leer uaeh.conf.
    "$DOCKER" run "${COMUNES[@]}" --user 1000:1000 --tmpfs /tmp:rw,size=256m -e TMPDIR=/tmp -e HOME=/tmp --workdir /skill \
      "$IMG" node --test /skill/validate-findings.test.cjs /skill/validate-coverage-ledger.test.cjs
    local rc=$?
    if [ $rc -eq 0 ]; then echo "VALIDAR pruebas: OK"; exit 0; fi
    echo "VALIDAR pruebas: FALLA (código $rc)"; exit 1
  fi

  conf_segura "$CONF"
  leer_conf "$CONF"
  ids_usuario
  COMUNES+=(--user "$UID_U:$GID_U")   # el run es del usuario de uaeh.conf: lo lee con su identidad
  RUN=$(normaliza_run "$1") || exit 64
  local rf rl
  corre validate-findings.cjs findings.json; rf=$?
  if [ $rf -eq 0 ]; then echo "VALIDAR findings: OK"; else echo "VALIDAR findings: FALLA (código $rf)"; fi
  corre validate-coverage-ledger.cjs coverage-ledger.json; rl=$?
  if [ $rl -eq 0 ]; then echo "VALIDAR ledger: OK"; else echo "VALIDAR ledger: FALLA (código $rl)"; fi
  [ $rf -eq 0 ] && [ $rl -eq 0 ]
}

corre(){  # $1 = validador, $2 = archivo dentro del run
  { [ -f "$RUN/$2" ] && [ ! -L "$RUN/$2" ]; } || { echo "uaeh-validar: falta $2 (o es enlace) en $RUN" >&2; return 2; }
  "$DOCKER" run "${COMUNES[@]}" --mount "type=bind,src=$RUN,dst=/run-audit,readonly" \
    "$IMG" node "/skill/$1" "/run-audit/$2"
}

# Cargado con «source» (pruebas del plugin) solo define funciones; ejecutado, corre principal.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then principal "$@"; fi
