#!/bin/sh
# Guarda global UAEH de git (core.hooksPath -> la copia estable del plugin uaeh-harness), hook "pre-applypatch".
# Primero el hook LOCAL (git am escribe el arbol DESPUES de este hook: lo que el local agregue cuenta); luego la
# revision global del CONTENIDO (guardia-commit.cjs contenido). Ciclo 7 (C4c): si hay hook local, el contenido se revisa
# tambien ANTES de el (am arma el arbol con su indice en memoria: un local que haga `git rm --cached .env` no debe
# ocultarlo a la revision de despues).
# Razones y detalle: hooks/guardia-git.js (hermano de esta carpeta; encabezado, CICLO 6 y 7) y hooks/guardia-commit.cjs.
case "$0" in */*) d="${0%/*}" ;; *) d=. ;; esac
if command -v node >/dev/null 2>&1; then n=node; else n="/c/Program Files/nodejs/node.exe"; fi
if ! command -v "$n" >/dev/null 2>&1 && ! [ -x "$n" ]; then
  echo "Guardia UAEH (git): no encuentro node -> commit negado (falla cerrado)." >&2
  exit 1
fi
g="$GIT_DIR"
if [ -z "$g" ]; then
  if [ -d .git ]; then g=.git
  elif [ -f .git ]; then read -r g < .git; g="${g#gitdir: }"
  elif [ -f HEAD ] && [ -d objects ] && [ -d refs ]; then g=.
  fi
fi
if [ -n "$g" ]; then
  c="$g"
  if [ -f "$g/commondir" ]; then
    read -r cdir < "$g/commondir"
    case "$cdir" in /*|?:*) c="$cdir" ;; *) c="$g/$cdir" ;; esac
  fi
else
  c="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
fi
l="$c/hooks/pre-applypatch"
if [ -f "$l" ] && [ -x "$l" ] && ! [ "$l" -ef "$0" ]; then
  "$n" "$d/../hooks/guardia-commit.cjs" contenido || exit 1
  "$l" "$@" || exit $?
fi
"$n" "$d/../hooks/guardia-commit.cjs" contenido || exit 1
exit 0
