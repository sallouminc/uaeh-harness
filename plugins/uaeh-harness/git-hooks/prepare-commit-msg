#!/bin/sh
# Guarda global UAEH de git (core.hooksPath -> la copia estable del plugin uaeh-harness), hook "prepare-commit-msg".
# Primero la revision global del CONTENIDO (guardia-commit.cjs contenido): git ya fijo el arbol del commit antes de
# este hook (medido), asi que lo que el hook local cambie en el indice no se commitea. Luego el hook local.
# Ciclo 7 (C2): con un mensaje NUEVO tambien se revisan el autor y el credito de Claude (un commit -n no corre
# commit-msg). Salida 3 = credito: si el commit-msg LOCAL del repo lo quita (se prueba sobre una copia), se quita ya;
# si no, se niega.
# Razones y detalle: hooks/guardia-git.js (hermano de esta carpeta; encabezado, CICLO 6 y 7) y hooks/guardia-commit.cjs.
case "$0" in */*) d="${0%/*}" ;; *) d=. ;; esac
if command -v node >/dev/null 2>&1; then n=node; else n="/c/Program Files/nodejs/node.exe"; fi
if ! command -v "$n" >/dev/null 2>&1 && ! [ -x "$n" ]; then
  echo "Guardia UAEH (git): no encuentro node -> commit negado (falla cerrado)." >&2
  exit 1
fi
"$n" "$d/../hooks/guardia-commit.cjs" contenido "$1" "$2"
s=$?
if [ "$s" -ne 0 ] && [ "$s" -ne 3 ]; then exit 1; fi
g="$GIT_DIR"
if [ -z "$g" ]; then
  if [ -d .git ]; then g=.git
  elif [ -f .git ]; then read -r g < .git; g="${g#gitdir: }"
  elif [ -f HEAD ] && [ -d objects ] && [ -d refs ]; then g=.
  fi
fi
if [ -n "$g" ]; then
  c="$g"
  if [ -f "$g/commondir" ]; then
    read -r cdir < "$g/commondir"
    case "$cdir" in /*|?:*) c="$cdir" ;; *) c="$g/$cdir" ;; esac
  fi
else
  c="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
fi
if [ "$s" -eq 3 ]; then
  t="$1"
  lc="$c/hooks/commit-msg"
  if [ -n "$c" ] && [ -f "$lc" ] && [ -x "$lc" ] && ! [ "$lc" -ef "$d/commit-msg" ]; then
    t="$1.uaeh-credito"
    if ! cp "$1" "$t" || ! "$lc" "$t" >/dev/null 2>&1; then rm -f "$t"; t="$1"; fi
  fi
  "$n" "$d/../hooks/guardia-commit.cjs" credito-local "$1" "$t"
  s=$?
  if [ "$t" != "$1" ]; then rm -f "$t"; fi
  if [ "$s" -ne 0 ]; then exit 1; fi
fi
l="$c/hooks/prepare-commit-msg"
if [ -f "$l" ] && [ -x "$l" ] && ! [ "$l" -ef "$0" ]; then
  exec "$l" "$@"
fi
exit 0
